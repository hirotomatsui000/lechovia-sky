{
  "name": "lechovia-skies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser flight-combat game with fictional aircraft over a Poland-inspired landscape: dogfights against AI pilots, objective modes and training.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/build-single.ts",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tournament": "node tools/tournament.ts"
  },
  "dependencies": {
    "@fontsource/rajdhani": "5.3.0",
    "@trystero-p2p/core": "^0.26.0",
    "@trystero-p2p/nostr": "^0.26.0",
    "@trystero-p2p/ws-relay": "^0.26.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
